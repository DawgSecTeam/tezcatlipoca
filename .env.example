# Copy to .env and fill in real values; .env is gitignored. Terraform reads TF_VAR_<name>
# directly (no terraform.tfvars); create-competition.py also loads this file and rewrites
# teams / boxes_per_team / box_password / box_username per competition.
#
# NAMING STANDARD — every variable read by this codebase is one of exactly three kinds:
#   TF_VAR_<name>  a Terraform input (terraform's own convention; do not rename).
#   TEZ_<NAME>     a tezcatlipoca runtime knob (new knobs MUST use this prefix).
#   NAKON_*/VULNDB_*  vendored-tool config, read by vendor/nakon, not by this repo.
# A variable that is none of these must be declared in tests/test_secret_hygiene.py's
# INTERNAL_ENV allowlist with a reason. tests/test_secret_hygiene.py fails the suite if
# code reads an env var that is neither documented here nor allowlisted — that is what
# keeps this list from drifting again.
# Per-variable detail: docs/usage-people.md "Configure the event".
# 2026-08-06 and 2026-10-01 git-history secret-leak audits: docs/known-issues.md.

# --- Proxmox connection ---
TF_VAR_proxmox_endpoint=https://PROXMOX-HOST:8006
TF_VAR_proxmox_api_token=CHANGEME
TF_VAR_proxmox_node=CHANGEME
TF_VAR_datastore=CHANGEME
# Optional Proxmox API TLS verification (default: unverified self-signed cert). Set ONE to pin:
#PROXMOX_CA_BUNDLE=/etc/pve/pve-root-ca.pem
#PROXMOX_TLS_FINGERPRINT=AA:BB:CC:DD:...   # sha256 of the pveproxy cert

# --- SSH keypair (Terraform, agent, nakon) ---
TF_VAR_ssh_public_key=ssh-ed25519 CHANGEME range-automation
TF_VAR_ssh_private_key_path=../proxmox

# --- Scoring engine template ---
TF_VAR_template_vm_id=CHANGEME
TF_VAR_vm_username=sysadmin

# --- Scoring engine addressing (optional; defaults in constants.py) ---
# Static mgmt IP for the engine. Leave unset to use DEFAULT_ENGINE_MGMT_IP.
#TF_VAR_engine_mgmt_ip=10.0.0.250
# Gateway for that static address. Leave unset to use DEFAULT_ENGINE_MGMT_GW.
#TF_VAR_engine_mgmt_gw=10.0.0.1
# Override the engine VMID (default 1000) when 1000 is taken on the node.
#TF_VAR_scoring_vm_id=1000

# --- Event settings (placeholders; the driver overwrites teams/boxes_per_team/box_password/box_username per competition) ---
TF_VAR_box_password=CHANGEME
TF_VAR_box_username=ubuntu
TF_VAR_event_name=Range 2026
TF_VAR_teams={"team1":{"identifier":"101","password":"CHANGEME"},"team2":{"identifier":"102","password":"CHANGEME"}}
TF_VAR_boxes_per_team=[{"name":"web01","last_octet":2,"cpu":2,"memory_mb":2048,"disk_gb":null,"template":"CHANGEME"}]
# Pin team subnets explicitly instead of deriving them from the team index.
# Comma/space separated identifiers, e.g. "221,222,223".
#TF_VAR_team_identifiers=101,102

# --- tezcatlipoca tuning knobs (TEZ_ prefix) ---
# Count this fraction (0 < x <= 1) of the *provisioned* disk math toward the datastore
# headroom preflight, for thin-provisioned pools where provisioned >> used.
# Omitted, the check uses full provisioned size. See docs/known-issues.md.
#TEZ_THIN_HEADROOM=0.5
# Concurrent ranges are supported (2026-10-04): the preflight WARNS when another deploy
# is in flight on this host and proceeds. Give each range its own --scoring-vmid and
# TF_VAR_team_identifiers blocks — the preflight refuses real collisions, and run-id
# ownership tags scope every teardown to its own deploy's VMs.
# Red's routed segment (bad-auto's deploy.red_subnet) when red01 runs in routed mode.
# Set it and every satellite jump VM accepts red -> local team subnets and SNATs red to
# the team gateway (192.168.<id>.1), exactly like engine -> box traffic — without it red's
# source matches no FORWARD rule and is dropped (scale8 soak 2026-10-02: 15/15 cred_sprays
# failed "unreachable over SSH" against satellite teams, 0 footholds). Unset/empty leaves
# the rules out, which is right for single-node ranges and masq-mode red. Read the value
# from bad-auto's config.yaml `deploy.red_subnet` (default 10.200.0.0/24).
# See docs/multi-node.md "Routed red".
#TEZ_RED_SEGMENT=10.200.0.0/24
# run-agent-scrim.py — red01's Proxmox template NAME, when the node's differs from
# bad-auto's built-in default (a .193 name; the .150 node wants base-ubuntu24.04-fix).
# Same as passing --red-template on every scrim.
#TEZ_RED_TEMPLATE=base-ubuntu24.04-fix

# --- Multi-node (optional) ---
# nodes.json references per-host API tokens BY ENV-VAR NAME; give each additional
# host's token its own variable here (e.g. TF_VAR_proxmox_api_token_193=...).
# See docs/multi-node.md. Absent nodes.json, everything is single-node.

# webui/server.py — the browser app's bind address/port (defaults shown) and an
# optional offline catalog fixture (JSON array of rows) for development only.
TEZ_WEBUI_HOST=127.0.0.1
TEZ_WEBUI_PORT=8765
#TEZ_WEBUI_CATALOG_FILE=

# test-artifacts.py — where test-run folders are archived outside the repo (the
# default ~/.tezcatlipoca/automated-tests survives discarding a practice worktree).
#TEZ_ARTIFACTS_ARCHIVE=

# vmid for the pfsense-provision template the builder tool creates (tools/build-pfsense-provision-template.py)
#TEZ_PFSENSE_PROVISION_VMID=957

# qemu-guest-agent retrofit knobs (tools/build-pfsense-provision-template.py agent-*):
# scratch VM vmid, node bridge for the SSH hop, package branch override (default: the
# guest's own ABI), and the dev-host staging dir for the downloaded .pkg closure.
#TEZ_PFSENSE_QGA_VMID=958
#TEZ_QGA_BRIDGE=vmbr0
#TEZ_QGA_PKG_BRANCH=
#TEZ_QGA_STAGE_DIR=/tmp/pfsense-qga-pkgs

# --- Remote access (headscale) ---
# Every deploy enrolls the scoring engine as a headscale subnet router and scopes
# participant access to their own team's network (docs/remote-access.md). The
# pipeline administers headscale over ssh+sudo on its host; these four are REQUIRED
# unless the Compfile opts out with `remote_access 0`.
TEZ_HEADSCALE_URL=https://headscale.example
TEZ_HEADSCALE_SSH_HOST=203.0.113.10
TEZ_HEADSCALE_SSH_USER=sysadmin
TEZ_HEADSCALE_SSH_PASSWORD=
# Owner of the router nodes (must exist on the headscale; default cyberrange-infra).
#TEZ_HEADSCALE_INFRA_USER=cyberrange-infra
# Participant preauth-key lifetime (headscale duration syntax; default 72h).
#TEZ_REMOTE_KEY_TTL=72h

# Student portal (Compfile `portal 1`; docs/portal.md). Put the tunnel pair ONLY in the event's
# env file — a practice worktree that carries it would claim the stable public hostname.
#   TEZ_PORTAL_TUNNEL_TOKEN  Cloudflare tunnel token (unset = portal reachable via ssh -L only)
#   TEZ_PORTAL_HOSTNAME      that tunnel's public hostname, for the one-owner check
#   TEZ_PORTAL_OPEN=1        start with team console access OPEN (practice runs; default closed)
#TEZ_PORTAL_TUNNEL_TOKEN=
#TEZ_PORTAL_HOSTNAME=range.example.com
#TEZ_PORTAL_OPEN=1
