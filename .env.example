# Copy this file to .env and fill in real values, then keep .env out of git (it is gitignored).
#
# SECURITY: a 2026-08-06 audit of this repo's full git history (all branches/refs) found a real
# admin password and team passwords for the CDE 2026 competition (since torn down) in a
# pre-2026-07-09 commit that predates the "stop tracking competition secrets" history rewrite.
# That commit is no longer reachable from any branch, but was pushed to GitHub before the
# rewrite, so treat it as permanently public regardless. The exposed password has been rotated
# and is no longer used anywhere. No real Proxmox API token or nakon/vulndb password was found
# anywhere in this repo's history — only the placeholder values shown below ever appear. If you
# maintain a separate `nakon` checkout, audit that repo's own history independently; it's out of
# scope here.
# Never commit real secrets; only this .env.example (placeholders only) belongs in git.
#
# Everything here is consumed two ways:
#   - Terraform reads TF_VAR_<name> automatically (no terraform.tfvars file needed at all).
#   - create-competition.py loads this file itself (python-dotenv) and rewrites
#     TF_VAR_teams / TF_VAR_boxes_per_team / TF_VAR_box_password / TF_VAR_box_username for you
#     when you create a competition — the rest you set once and leave alone.
# See docs/usage-people.md "Configure the event" for what each value means and where it comes from.

# --- Proxmox connection (see docs/usage-people.md "Prerequisites") ---
TF_VAR_proxmox_endpoint=https://PROXMOX-HOST:8006
TF_VAR_proxmox_api_token=CHANGEME
TF_VAR_proxmox_node=CHANGEME
TF_VAR_datastore=CHANGEME

# --- SSH keypair used by Terraform, the agent, and nakon ---
TF_VAR_ssh_public_key=ssh-ed25519 CHANGEME range-automation
TF_VAR_ssh_private_key_path=../proxmox

# --- Scoring engine template (see docs/usage-people.md "Adding a template VM") ---
TF_VAR_template_vm_id=CHANGEME
TF_VAR_vm_username=sysadmin

# --- Event settings ---
# quotient_admin_password / event_name / teams / boxes_per_team / box_password below are just
# placeholders — create-competition.py overwrites teams/boxes_per_team/box_password/box_username
# every time you create or reuse a competition (it also saves the box list into that
# competition's boxes.json, so reusing one later replays its exact boxes). Only matter by hand
# if you run `terraform apply` directly without the script.
TF_VAR_quotient_admin_password=CHANGEME
TF_VAR_box_password=CHANGEME
TF_VAR_box_username=ubuntu
TF_VAR_event_name=Range 2026
TF_VAR_teams={"team1":{"identifier":"101","password":"CHANGEME"},"team2":{"identifier":"102","password":"CHANGEME"}}
TF_VAR_boxes_per_team=[{"name":"web01","last_octet":2,"cpu":2,"memory_mb":2048,"disk_gb":null,"template":"CHANGEME"}]
