# Copy to .env and fill in real values; .env is gitignored. Terraform reads TF_VAR_<name>
# directly (no terraform.tfvars); create-competition.py also loads this file and rewrites
# teams / boxes_per_team / box_password / box_username per competition.
#
# NAMING STANDARD — every variable read by this codebase is one of exactly three kinds:
#   TF_VAR_<name>  a Terraform input (terraform's own convention; do not rename).
#   TEZ_<NAME>     a tezcatlipoca runtime knob (new knobs MUST use this prefix).
#   NAKON_*/VULNDB_*  vendored-tool config, read by vendor/nakon, not by this repo.
# A variable that is none of these must be declared in tests/test_secret_hygiene.py's
# INTERNAL_ENV allowlist with a reason. tests/test_secret_hygiene.py fails the suite if
# code reads an env var that is neither documented here nor allowlisted — that is what
# keeps this list from drifting again.
# Per-variable detail: docs/usage-people.md "Configure the event".
# 2026-08-06 and 2026-10-01 git-history secret-leak audits: docs/known-issues.md.

# --- Proxmox connection ---
TF_VAR_proxmox_endpoint=https://PROXMOX-HOST:8006
TF_VAR_proxmox_api_token=CHANGEME
TF_VAR_proxmox_node=CHANGEME
TF_VAR_datastore=CHANGEME
# Optional Proxmox API TLS verification (default: unverified self-signed cert). Set ONE to pin:
#PROXMOX_CA_BUNDLE=/etc/pve/pve-root-ca.pem
#PROXMOX_TLS_FINGERPRINT=AA:BB:CC:DD:...   # sha256 of the pveproxy cert

# --- SSH keypair (Terraform, agent, nakon) ---
TF_VAR_ssh_public_key=ssh-ed25519 CHANGEME range-automation
TF_VAR_ssh_private_key_path=../proxmox

# --- Scoring engine template ---
TF_VAR_template_vm_id=CHANGEME
TF_VAR_vm_username=sysadmin

# --- Scoring engine addressing (optional; defaults in constants.py) ---
# Static mgmt IP for the engine. Leave unset to use DEFAULT_ENGINE_MGMT_IP.
#TF_VAR_engine_mgmt_ip=10.0.0.250
# Gateway for that static address. Leave unset to use DEFAULT_ENGINE_MGMT_GW.
#TF_VAR_engine_mgmt_gw=10.0.0.1
# Override the engine VMID (default 1000) when 1000 is taken on the node.
#TF_VAR_scoring_vm_id=1000

# --- Event settings (placeholders; the driver overwrites teams/boxes_per_team/box_password/box_username per competition) ---
TF_VAR_box_password=CHANGEME
TF_VAR_box_username=ubuntu
TF_VAR_event_name=Range 2026
TF_VAR_teams={"team1":{"identifier":"101","password":"CHANGEME"},"team2":{"identifier":"102","password":"CHANGEME"}}
TF_VAR_boxes_per_team=[{"name":"web01","last_octet":2,"cpu":2,"memory_mb":2048,"disk_gb":null,"template":"CHANGEME"}]
# Pin team subnets explicitly instead of deriving them from the team index.
# Comma/space separated identifiers, e.g. "221,222,223".
#TF_VAR_team_identifiers=101,102

# --- tezcatlipoca tuning knobs (TEZ_ prefix) ---
# Count this fraction (0 < x <= 1) of the *provisioned* disk math toward the datastore
# headroom preflight, for thin-provisioned pools where provisioned >> used.
# Omitted, the check uses full provisioned size. See docs/known-issues.md.
#TEZ_THIN_HEADROOM=0.5
# Proceed even when another deploy is already running against this host. The preflight
# refuses by default: two concurrent deploys race for the same vmid blocks and golden
# slots, and the recorded outcome is a foreign template in this competition's golden slot
# plus one sweep destroying another range's engines. Set this ONLY once you have given
# each range distinct --scoring-vmid and TF_VAR_team_identifiers blocks.
#TEZ_ALLOW_CONCURRENT=1

# --- Multi-node (optional) ---
# nodes.json references per-host API tokens BY ENV-VAR NAME; give each additional
# host's token its own variable here (e.g. TF_VAR_proxmox_api_token_193=...).
# See docs/multi-node.md. Absent nodes.json, everything is single-node.
