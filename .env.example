# Copy this file to .env and fill in real values. .env is gitignored — never commit it.
# Everything here is consumed two ways:
#   - Terraform reads TF_VAR_<name> automatically (no terraform.tfvars file needed at all).
#   - create-competition.py loads this file itself (python-dotenv) and rewrites
#     TF_VAR_event_name / TF_VAR_quotient_admin_password / TF_VAR_teams for you when you
#     create a competition — the rest you set once and leave alone.
# See README.md "Configure the event" for what each value means and where it comes from.

# --- Proxmox connection (see README Prerequisites) ---
TF_VAR_proxmox_endpoint=https://10.0.0.10:8006
TF_VAR_proxmox_api_token=terraform@pve!automation=00000000-0000-0000-0000-000000000000
TF_VAR_proxmox_node=pve
TF_VAR_datastore=local-lvm

# --- SSH keypair used by Terraform, the agent, and nakon ---
TF_VAR_ssh_public_key=ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAA... range-automation
TF_VAR_ssh_private_key_path=../proxmox

# --- Scoring engine template (see README "Adding a template VM") ---
TF_VAR_template_vm_id=9106
TF_VAR_vm_username=sysadmin
TF_VAR_vm_password=asdf

# --- Event settings ---
# event_name / quotient_admin_password / teams / boxes_per_team below are just placeholders —
# create-competition.py overwrites all four of these every time you create or reuse a
# competition (it also saves the box list into that competition's boxes.json, so reusing one
# later replays its exact boxes rather than whatever happens to be here). Only matters by hand
# if you're running `terraform apply` directly without going through the script.
TF_VAR_quotient_admin_password=changeme
TF_VAR_event_name=Range 2025
TF_VAR_teams={"team1":{"identifier":"1","password":"team1pass"},"team2":{"identifier":"2","password":"team2pass"}}
TF_VAR_boxes_per_team=[{"name":"web01","last_octet":2,"cpu":2,"memory_mb":2048,"disk_gb":20,"template":"tmpl-ubuntu-22"},{"name":"ssh01","last_octet":3,"cpu":1,"memory_mb":1024,"disk_gb":10,"template":"tmpl-ubuntu-22"}]
