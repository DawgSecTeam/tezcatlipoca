# Copy this file to .env and fill in real values, then keep .env out of git (it is gitignored).
#
# SECURITY: a real Proxmox API token and the vulndb (nakon) password were committed to this
# repo's history earlier. Treat them as compromised — ROTATE them before using this range:
#   - regenerate the Proxmox API token (TF_VAR_proxmox_api_token) in the Proxmox UI, and
#   - change the nakon/vulndb DB password (nakon/.env) and this file's placeholders below.
# Never commit real secrets; only this .env.example (placeholders only) belongs in git.
#
# Everything here is consumed two ways:
#   - Terraform reads TF_VAR_<name> automatically (no terraform.tfvars file needed at all).
#   - create-competition.py loads this file itself (python-dotenv) and rewrites
#     TF_VAR_event_name / TF_VAR_quotient_admin_password / TF_VAR_teams / TF_VAR_boxes_per_team
#     for you when you create a competition — the rest you set once and leave alone.
# See README.md "Configure the event" for what each value means and where it comes from.

# --- Proxmox connection (see README Prerequisites) ---
TF_VAR_proxmox_endpoint=https://PROXMOX-HOST:8006
TF_VAR_proxmox_api_token=CHANGEME
TF_VAR_proxmox_node=CHANGEME
TF_VAR_datastore=CHANGEME

# --- SSH keypair used by Terraform, the agent, and nakon ---
TF_VAR_ssh_public_key=ssh-ed25519 CHANGEME range-automation
TF_VAR_ssh_private_key_path=../proxmox

# --- Scoring engine template (see README "Adding a template VM") ---
TF_VAR_template_vm_id=CHANGEME
TF_VAR_vm_username=sysadmin
TF_VAR_vm_password=CHANGEME

# --- Event settings ---
# quotient_admin_password / event_name / teams / boxes_per_team below are just placeholders —
# create-competition.py overwrites all of them every time you create or reuse a competition
# (it also saves the box list into that competition's boxes.json, so reusing one later replays
# its exact boxes). Only matter by hand if you run `terraform apply` directly without the script.
TF_VAR_quotient_admin_password=CHANGEME
TF_VAR_event_name=Range 2026
TF_VAR_teams={"team1":{"identifier":"101","password":"CHANGEME"},"team2":{"identifier":"102","password":"CHANGEME"}}
TF_VAR_boxes_per_team=[{"name":"web01","last_octet":2,"cpu":2,"memory_mb":2048,"disk_gb":null,"template":"CHANGEME"}]
