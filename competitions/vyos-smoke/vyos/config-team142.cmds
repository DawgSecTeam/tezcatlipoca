configure
set system host-name fw-team142
set system console device ttyS0 speed 115200
set interfaces ethernet eth0 address 172.31.142.2/30
set protocols static route 0.0.0.0/0 next-hop 172.31.142.1
set service ssh port 22
set nat destination rule 10 description 'apt-cacher (engine service at the old gateway address)'
set nat destination rule 10 destination address 192.168.142.1
set nat destination rule 10 destination port 3142
set nat destination rule 10 protocol tcp
set nat destination rule 10 translation address 172.31.142.1
set nat destination rule 10 translation port 3142
set nat destination rule 20 description 'beacon C2 DNAT (firewall owns the gateway address)'
set nat destination rule 20 destination address 192.168.142.1
set nat destination rule 20 destination port 22
set nat destination rule 20 protocol tcp_udp
set nat destination rule 20 translation address 192.168.142.2
set nat destination rule 20 translation port 22
commit
save
exit
show configuration commands | grep host-name
exit
