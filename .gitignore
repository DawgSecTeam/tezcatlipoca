# Every .env variant is secret-bearing (the Proxmox API token, box + team passwords). The
# blanket rule exists because a hand-named backup (".env.pre-...") once stayed tracked and
# reached the public remote; tezcatlipoca.example.toml is the configuration reference and
# no env template ships. Enforced by tests/test_secret_hygiene.py.
.env
.env.*
# The native config profile (estate.config): per-node, secret-bearing by reference.
tezcatlipoca.toml
tezcatlipoca.*.toml
!tezcatlipoca.example.toml
# Estate ground truth (endpoints, node names, tokens-by-reference, vmid maps, live state):
# local only, never published. Tracked docs and prompts point here instead of carrying
# infrastructure specifics. Enforced by tests/test_secret_hygiene.py.
infrastructure-status.md
.tez-backups/
# Per-stream git worktrees used for parallel development/merges
.worktrees/
venv/
quotient/__pycache__/
.claude
__pycache__/
proxmox
deploy.log
deploy-*.log
logs/
.deploy.lock
.zcode/
artifacts/rawsockets-beacon/build/
nodes.json
coverage-run1.json

# Competition DEFINITIONS live in tezcatlipoca-competitions, so a `competitions/` directory
# here is a leftover run workspace: it carries credentials.txt, teams.json and
# estate-state.json (box/admin/inject passwords, the run identity), the per-run
# .automated-tests/ evidence, and the template/placement records. It also shadows the
# sibling repo in common/comp_paths.comps_root() (the suite then reads a stale partial comp
# set). Nothing under it is tracked. Enforced by tests/test_secret_hygiene.py — the tracked
# set is asserted, not the rule: a force-add has defeated a .gitignore line in this repo
# before.
competitions/


# vim swap files (a twin session's live editor buffer must never be commit-swallowed)
*.swp
