# Blanket rule, deliberately: every .env variant is secret-bearing (Proxmox API
# token, box + per-team passwords). The old rule listed ".env" and
# ".env.realm-backup*" by name, so a hand-made backup called
# ".env.pre-cde-20260929" stayed tracked for weeks and reached the public remote.
# Only the placeholder template ships. Enforced by tests/test_secret_hygiene.py.
.env
.env.*
!.env.example
.tez-backups/
# Per-stream git worktrees used for parallel development/merges
.worktrees/
venv/
terraform/terraform.tfvars
terraform/.terraform/
terraform/.terraform.lock.hcl
terraform/*.tfstate
terraform/*.tfstate.*
quotient/__pycache__/
.claude
__pycache__/
proxmox
deploy.log
deploy-*.log
logs/
competitions/*/teams.json
competitions/*/event.conf
competitions/*/linux.credlist
competitions/*/cloned_vms.json
competitions/*/credentials.txt
competitions/*/.deploy_state.json
competitions/*/.deploy-timings.jsonl
competitions/*/nakon-config.json
competitions/*/.nakon-domain-*.json
competitions/*/.nakon-golden.json
competitions/*/.nakon-postclone.json
competitions/*/.nakon-repair.json
competitions/*/.nakon-final.json
competitions/*/.frozen.json
competitions/*/.template-hashes.json
competitions/*/.phase6-swept
.deploy.lock
competitions/*/box_vulns.json.pre-cyberfield-prune1
competitions/*/targets.json
competitions/*/known_hosts
terraform/.terraform-plugin-cache/
competitions/distro-matrix-2026-09-27/terraform/
.zcode/
artifacts/rawsockets-beacon/build/
competitions/*/terraform/
competitions/*/.postclone-swept
# Per-run test artifacts (competitions/<id>/.automated-tests/<run-id>/): box-pulled red/blue
# reports, raw evidence under evidence/, the synthesis REPORT.md, and the machine manifests.
# Ignored deliberately and with NO publish path — these quote flags, credentials and inject
# answers, and "quote a password in prose" is exactly what tests/test_secret_hygiene.py's
# pattern net cannot catch. A tool recommendation leaves this folder by being written into
# docs/known-issues.md or a fixes plan, never by copying the artifact into git. Enforced by
# test_no_test_artifact_is_tracked (the tracked set is asserted, not the rule: a force-add has
# defeated a .gitignore line in this repo before).
competitions/*/.automated-tests/

# competition terraform artifacts carry dead per-comp passwords — three
# reference comps keep theirs tracked on purpose (force-add to refresh a
# snapshot); these close the layouts that slipped through: comp-dir
# top-level tfstate/tfvars (how scrim-dress-2026-09-20/terraform.tfstate got
# committed), per-comp logs (m4-resume-current.log carried deploy-state
# passwords), and root terraform/ tfvars variants
competitions/*/*.tfstate*
competitions/*/terraform.tfvars*
competitions/*/*.log
terraform/terraform.tfvars*
# packet-compiled secrets (compile-packet.py): packet-published creds, decoy
# account passwords, AD account passwords
competitions/*/passwords.json
competitions/*/box_baseline.json
competitions/*/domain_accounts.json
nodes.json
coverage-run1.json
